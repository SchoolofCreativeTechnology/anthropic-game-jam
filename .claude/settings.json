{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat*)",
      "Bash(git diff HEAD*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(python3 -m http.server 8000 --bind 127.0.0.1)",
      "Bash(py -m http.server 8000 --bind 127.0.0.1)",
      "Bash(node --check *)",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:8000/)",
      "Bash(git init*)",
      "Bash(git config user.name*)",
      "Bash(git config user.email*)",
      "Bash(git remote *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse *)",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(gh auth status*)",
      "Bash(gh api user*)",
      "Bash(python3 --version)",
      "Bash(py --version)",
      "Bash(python --version)",
      "Bash(uname *)",
      "Bash(date *)",
      "Bash(command -v *)",
      "Bash(which *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(sleep *)",
      "Bash(git status *)",
      "Bash(test -f *)",
      "Bash(python -m http.server 8000 --bind 127.0.0.1)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.claude/settings.local.json)",
      "Edit(./.claude/settings.local.json)",
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(cat *settings.local.json*)",
      "Bash(head *settings.local.json*)",
      "Bash(tail *settings.local.json*)",
      "Bash(less *settings.local.json*)",
      "Bash(grep *settings.local.json*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)",
      "Bash(set)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git diff --no-index*)"
    ]
  }
}
