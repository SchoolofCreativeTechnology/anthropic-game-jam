{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat*)",
      "Bash(git diff HEAD*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(node --check *)",
      "Bash(node --version)",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:8000/)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8000/)",
      "Bash(curl -s -o /dev/null -w '%{http_code}\\n' http://localhost:8000/)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\n\" http://localhost:8000/)",
      "Bash(git init*)",
      "Bash(git config user.name*)",
      "Bash(git config user.email*)",
      "Bash(git remote *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-files*)",
      "Bash(git rev-parse *)",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(gh auth status*)",
      "Bash(gh api user*)",
      "Bash(python3 --version)",
      "Bash(py --version)",
      "Bash(python --version)",
      "Bash(uname *)",
      "Bash(date *)",
      "Bash(command -v *)",
      "Bash(which *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(sleep *)",
      "Bash(git status *)",
      "Bash(test -f *)",
      "Bash(python3 -m json.tool meta.json)",
      "Bash(py -m json.tool meta.json)",
      "Bash(python -m json.tool meta.json)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.claude/settings.local.json)",
      "Edit(./.claude/settings.local.json)",
      "Read(./.env)",
      "Edit(./.env)",
      "Bash(cat *settings.local.json*)",
      "Bash(head *settings.local.json*)",
      "Bash(tail *settings.local.json*)",
      "Bash(less *settings.local.json*)",
      "Bash(grep *settings.local.json*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv*)",
      "Bash(set)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git diff --no-index*)",
      "Bash(sed *settings.local.json*)",
      "Bash(awk *settings.local.json*)",
      "Bash(python3 *settings.local.json*)",
      "Bash(py *settings.local.json*)",
      "Bash(python *settings.local.json*)",
      "Bash(node *settings.local.json*)",
      "Bash(wc *settings.local.json*)",
      "Bash(strings *settings.local.json*)",
      "Bash(xxd *settings.local.json*)",
      "Bash(od *settings.local.json*)",
      "Bash(base64 *settings.local.json*)",
      "Bash(cut *settings.local.json*)",
      "Bash(sort *settings.local.json*)",
      "Bash(more *settings.local.json*)",
      "Bash(perl *settings.local.json*)",
      "Bash(ruby *settings.local.json*)",
      "Bash(jq *settings.local.json*)",
      "Bash(cp *settings.local.json*)",
      "Bash(mv *settings.local.json*)",
      "Bash(source *settings.local.json*)",
      "Bash(. *settings.local.json*)"
    ]
  }
}
